{
  "name": "@ftptech/x402-canton-client",
  "version": "1.4.0",
  "description": "Payer-side x402 client for Canton: a fetch wrapper that pays a 402 with a signed Canton transfer.",
  "license": "Apache-2.0",
  "author": "FTP team",
  "homepage": "https://github.com/FTP-Tech-LLC/x402-canton-agent/tree/main/packages/client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FTP-Tech-LLC/x402-canton-agent.git",
    "directory": "packages/client"
  },
  "bugs": {
    "url": "https://github.com/FTP-Tech-LLC/x402-canton-agent/issues"
  },
  "keywords": [
    "x402",
    "canton",
    "canton-network",
    "client",
    "payment",
    "fetch",
    "agent"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@ftptech/x402-canton-core": "^1.9.0",
    "@ftptech/x402-canton-ledger": "^0.6.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
