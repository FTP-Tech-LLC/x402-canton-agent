{
  "name": "@ftptech/canton-x402-mcp",
  "private": false,
  "version": "2.7.0",
  "description": "MCP server that gives an AI agent a self-custody Canton x402 wallet with spend limits set by its owner.",
  "license": "Apache-2.0",
  "author": "FTP team",
  "type": "module",
  "bin": {
    "canton-x402-mcp": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "gen:guide": "node scripts/gen-guide.mjs",
    "build": "node scripts/gen-guide.mjs && tsc -p tsconfig.json",
    "typecheck": "node scripts/gen-guide.mjs && tsc -p tsconfig.json --noEmit",
    "test": "node scripts/gen-guide.mjs && vitest run",
    "lint": "eslint src --max-warnings 0"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@ftptech/canton-agent-wallet": "workspace:^",
    "@ftptech/x402-canton-core": "^1.9.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  },
  "publishConfig": {
    "access": "public"
  }
}
