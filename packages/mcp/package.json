{
  "name": "@ftptech/canton-x402-mcp",
  "private": false,
  "version": "1.1.0",
  "description": "MCP server exposing a self-custody Canton x402 agent wallet as tools. A human connects it out-of-band (claude mcp add); read tools auto-allow, pay/withdraw are ask/cap. Thin wrapper over @ftptech/canton-agent-wallet.",
  "license": "Apache-2.0",
  "author": "FTP team",
  "type": "module",
  "bin": {
    "canton-x402-mcp": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src --max-warnings 0"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@ftptech/canton-agent-wallet": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  },
  "publishConfig": {
    "access": "public"
  }
}
